# Copy to .env (cp deploy/production.env.example .env) on the server and fill in. Never commit the real file.

# The public address of the API. A real subdomain, or <server-ip-with-dashes>.sslip.io
# for a free temporary one, e.g. 130-61-10-20.sslip.io
API_DOMAIN=api.example.com

# Memory ceiling for the API container. 1500m suits the 6 to 12 GB ARM server.
# On the 1 GB AMD server use 600m, and also set SIM_MAX_CONCURRENCY=1 and DB_POOL_SIZE=2.
API_MEM_LIMIT=1500m

# Supabase session pooler (port 5432). URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=bitcode
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Vercel address of the Bitcode web app (comma-separate several).
CORS_ORIGINS=https://your-bitcode-app.vercel.app

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

BOOTSTRAP_ADMIN_EMAIL=admin@bitcode.dev
BOOTSTRAP_ADMIN_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
FEEDBACK_ENABLED=true

IVERILOG_BIN=iverilog
VVP_BIN=vvp
SIM_JOB_DIR=/tmp
SIM_COMPILE_TIMEOUT=10
SIM_RUN_TIMEOUT=10
SIM_CPU_SECONDS=5
SIM_MEMORY_MB=256
SIM_MAX_OUTPUT_BYTES=65536
SIM_MAX_CONCURRENCY=3
SIM_MAX_CODE_BYTES=32768
RATE_RUN_PER_MIN=20
RATE_SUBMIT_PER_MIN=6
SEED_ON_BOOT=true
LOG_LEVEL=INFO
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_TIMEOUT_SECONDS=30
