# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=bitcode
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=bitcode
POSTGRES_PORT=5432
# api reads this; host is the compose service name
DATABASE_URL=postgresql+psycopg://bitcode:change_me_local_only@db:5432/bitcode

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=generate_with__openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# first boot creates this admin if it does not exist
BOOTSTRAP_ADMIN_EMAIL=admin@bitcode.dev
BOOTSTRAP_ADMIN_PASSWORD=change_me_local_only

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# confirm the exact current id in your OpenAI dashboard before first run
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=400
# hard off-switch: grading still works, hints fall back to the authored text
FEEDBACK_ENABLED=true

# ── Simulator sandbox ─────────────────────────────────────────────────────
IVERILOG_BIN=iverilog
VVP_BIN=vvp
SIM_JOB_DIR=/tmp
SIM_COMPILE_TIMEOUT=10
SIM_RUN_TIMEOUT=10
SIM_CPU_SECONDS=5
SIM_MEMORY_MB=256
SIM_MAX_OUTPUT_BYTES=65536
SIM_MAX_CONCURRENCY=3
SIM_MAX_CODE_BYTES=32768

# ── Rate limits (per user per minute) ─────────────────────────────────────
RATE_RUN_PER_MIN=20
RATE_SUBMIT_PER_MIN=6

# ── App ───────────────────────────────────────────────────────────────────
API_PORT=7860
# Comma-separated browser origins allowed to call the api. Add the live
# Bitcode and Bitronics origins when they exist.
CORS_ORIGINS=http://localhost:3010
SEED_ON_BOOT=true
LOG_LEVEL=INFO

# ── Frontend (web service) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:7860
# Where "Bitronics" in the footer links to. Replace with the live site.
NEXT_PUBLIC_BITRONICS_URL=http://localhost:3010
WEB_PORT=3010

# ── Supabase: shared sign-in and (later) the database ────────────────────
# One Supabase project serves the Bitronics site and Bitcode. Leave the keys
# empty to hide the Google button. All of these are per-environment values:
# set them for each deployment, nothing here is hard-coded in the code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Single sign-on across both sites. Empty = host-only cookie, which already
# works locally (cookies ignore ports, so localhost:3010 and :3011 share it).
# In production set the shared parent domain, with a leading dot, e.g.
# .example.com, once the domains exist. It must match on both sites.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# This site's own public origin, used for the Google redirect. Empty = the
# origin the browser is on. Set it behind a proxy or on the live domain.
NEXT_PUBLIC_SITE_URL=

# To run on the Supabase Postgres instead of the local container, point
# DATABASE_URL at the SESSION-mode pooler (port 5432, user postgres.<ref>,
# percent-encode any special characters in the password) and set a schema so
# Bitcode's tables never mix with the Bitronics site's:
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<pooler-host>:5432/postgres
#   DATABASE_SCHEMA=bitcode
#   DB_POOL_SIZE=3
#   DB_MAX_OVERFLOW=2
# Then run `alembic upgrade head` once; it creates the schema. Empty = public.
DATABASE_SCHEMA=
